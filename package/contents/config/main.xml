<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Personal Todoist API token. Stored unencrypted in the Plasma config (documented tradeoff). -->
    <entry name="apiToken" type="String">
      <default></default>
    </entry>
    <!-- Display name of the connected account ("Connected as …"). -->
    <entry name="accountName" type="String">
      <default></default>
    </entry>
    <!-- View this widget starts with: "" (last used), today, upcoming, inbox, project:<id>, label:<id>, filter:<id> -->
    <entry name="pinnedView" type="String">
      <default></default>
    </entry>
    <!-- Unsaved filter query (Todoist filter syntax) shown as its own list, and its name -->
    <entry name="customQuery" type="String">
      <default></default>
    </entry>
    <entry name="customQueryName" type="String">
      <default></default>
    </entry>
    <!-- Panel badge: today (overdue + today), view (current view), none -->
    <entry name="badgeSource" type="String">
      <default>today</default>
    </entry>
  </group>
</kcfg>
